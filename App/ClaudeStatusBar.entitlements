<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Full App Sandbox (App Store-grade isolation). -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Outgoing HTTPS only: provider usage/auth hosts and Sparkle appcast + update download. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Incoming connections, for one purpose only: the Codex sign-in redirects to
         http://localhost:1455/auth/callback, an address fixed by the OAuth client, so the
         app must briefly accept that one loopback request. The listener is bound to the
         loopback interface, started when a Codex sign-in begins and closed as soon as the
         code arrives or the attempt times out. The Anthropic flow needs none of this. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Sparkle XPC communication, scoped to Sparkle's own Mach service names. -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>cz.mihalic.claude-status-bar-spks</string>
        <string>cz.mihalic.claude-status-bar-spki</string>
    </array>
</dict>
</plist>
